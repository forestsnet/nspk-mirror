# Режим развёртывания, файлы через двоеточие:
#   docker-compose.yml                           nginx только по HTTP (TLS снаружи) и выпуск сертификата
#   docker-compose.yml:docker-compose.tls.yml    nginx сам держит HTTPS с Let's Encrypt
#   docker-compose.yml:docker-compose.host.yml   без nginx в compose, зеркало на 127.0.0.1 для nginx хоста
COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml

# Домен зеркала, A-запись на этот сервер
MIRROR_DOMAIN=sbp.example.com

# Адрес, на который переписываются ссылки страницы НСПК и QR в режиме «Камерой телефона»
MIRROR_ORIGIN=https://sbp.example.com

# Антифрод: мерчанты, чьи QR показывает зеркало, merchantId или legalId из ответа НСПК через запятую.
# Пусто — любой QR. Свои ID: bin/link.php по ссылке на оплату или строка «blocked» в логе зеркала.
ALLOWED_MERCHANTS=MA0007117316,LB0003004344

# 1 — если НСПК не ответила и мерчанта не проверить, оплата не показывается. 0 — показывается.
MERCHANT_STRICT=0

# Ключ подписи для /api/link. Пусто — создаётся сам в томе кэша.
MIRROR_SECRET=

# Порты nginx на хосте
HTTP_PORT=80
HTTPS_PORT=443

# Сертификаты: ./letsencrypt для certbot из compose или /etc/letsencrypt certbot хоста
LETSENCRYPT_DIR=./letsencrypt

# Порт зеркала на 127.0.0.1 в режиме docker-compose.host.yml
MIRROR_PORT=8080
